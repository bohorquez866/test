generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model WatchlistItem {
  id         String   @id @default(cuid())
  visitorId  String
  tmdbId     Int
  title      String
  posterPath String?
  createdAt  DateTime @default(now())

  @@unique([visitorId, tmdbId])
}
